{
  "welcomeFile": "salesanalytics/webapp/index.html",
  "authenticationMethod": "route",
  "sessionTimeout": 10,
  "routes": [
    {
      "source": "^/salesanalytics/webapp/(.*)",
      "localDir": "salesanalytics/webapp/",
      "target": "$1",
      "authenticationType": "xsuaa",
      "csrfProtection": true
    },
    {
      "source": "^/(.*)$",
      "target": "$1",
      "destination": "srv-api",
      "authenticationType": "xsuaa",
      "csrfProtection": true
    }
  ],
  "logout": {
    "logoutEndpoint": "/logout",
    "logoutPage": "https://www.anubhavtrainings.com"
  }
}
